    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "emulate": "^0.10.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.12",
