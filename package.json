{
  "name": "alquimia",
  "scripts": {
    "dev": "next dev",
    "setup:local": "node scripts/setup-local.mjs",
    "build": "drizzle-kit migrate && next build",
    "start": "next start",
    "lint": "ultracite check",
    "check": "ultracite check && node scripts/check-messages.mjs",
    "fix": "ultracite fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local lib/db/seed.ts",
    "email:dev": "email dev --dir emails --port 3001",
    "emulate": "emulate --service google,resend",
    "dev:discord": "node --env-file=.env.local dev/discord-stub.mjs",
    "dev:services": "concurrently -n emulate,discord -c cyan,magenta \"pnpm emulate\" \"pnpm dev:discord\"",
    "check:messages": "node scripts/check-messages.mjs",
    "vercel:env": "bash scripts/vercel-env-push.sh",
    "db:up": "docker start alquimia-pg 2>/dev/null || docker run -d --name alquimia-pg -e POSTGRES_USER=alquimia -e POSTGRES_PASSWORD=alquimia -e POSTGRES_DB=alquimia_dev -p 55432:5432 postgres:16-alpine",
    "db:down": "docker stop alquimia-pg",
    "db:reset": "pnpm db:migrate && pnpm db:seed",
    "inbox": "node --env-file=.env.local scripts/inbox.mjs"
  },
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@better-auth/infra": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.3.2",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "^2.8.0",
    "autoprefixer": "^10.4.20",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "^0.564.0",
    "nanoid": "^6.0.1",
    "next": "16.2.0",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-day-picker": "9.13.2",
    "react-dom": "^19",
