# Copiar a `.env.local` y completar. `.env.local` esta gitignoreado.
# Para desarrollo local hay emuladores: ver docs/launchpad-setup.md

# --- Base de datos (Neon en Vercel, Postgres en Docker en local) ---
DATABASE_URL=

# --- Better Auth ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Opcional. En Vercel se deriva sola de VERCEL_URL; en local, de localhost:3000.
BETTER_AUTH_URL=

# --- Google OAuth ---
# App de dev para local y previews; app de prod para produccion.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Discord OAuth + verificacion de miembro ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Opcional: solo para apuntar la API de Discord a un mock propio.
# El stub local no la necesita: se resuelve por providerId.
DISCORD_API_BASE=

# --- Vercel Blob (logos) ---
# Vacio en local: los uploads caen a public/dev-uploads/
BLOB_READ_WRITE_TOKEN=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="Alquimia <hola@alquimia.community>"
# Mail del equipo que recibe el aviso de proyecto nuevo en la cola
RESEND_ADMIN_EMAIL=
# Solo desarrollo: apunta la API de Resend al emulador
RESEND_BASE_URL=

# --- Admins iniciales (separados por coma) ---
ADMIN_EMAILS=

# --- Opcional ---
# Fuerza la URL publica (metadata, mails, links para compartir).
# Por defecto: https://alquimia.community en produccion.
NEXT_PUBLIC_SITE_URL=
